# Copia este archivo como ".env" en la raíz del proyecto (junto a docker-compose.yml)
# y reemplaza los valores. Este archivo (.env) NO debe subirse al repositorio.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=barberia_db
MYSQL_USER=barberia_user
MYSQL_PASSWORD=changeme

# --- Correo (Gmail) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=tu_correo@gmail.com
MAIL_PASS=tu_app_password

# --- API DNI ---
API_DNI_TOKEN=tu_token_aqui

# --- Usuario admin inicial (admin@gmail.com) ---
ADMIN_PASSWORD=admin123

# --- Datos de demostración ---
# true = al arrancar con la BD sin barberos, carga barberos, servicios, productos,
# clientes, citas y 90 días de ventas ficticias. No toca una BD que ya tiene datos.
DEMO_DATA=true

# --- U2: IA con Google Gemini (https://aistudio.google.com/apikey) ---
# Sin clave, el asesor funciona en modo demostración.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- U3: IoT ---
# Con docker compose el broker es el contenedor "mosquitto".
# Para recibir los datos del ESP32 de Wokwi usa: MQTT_BROKER_URL=tcp://broker.hivemq.com:1883
MQTT_BROKER_URL=tcp://mosquitto:1883
MQTT_TOPIC_PREFIX=laclasica
# Token para nodos que envían por HTTP (cabecera X-IOT-TOKEN). Vacío = entrada HTTP desactivada.
IOT_HTTP_TOKEN=
# Sillas que simula el contenedor iot-simulador (= id de los barberos)
IOT_SILLAS=1,2,3,4
